# Copy to .env (git-ignored) and fill in. Never commit real values.

# Gemini API key (Google AI Studio). Free tier works for development.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project that runs and pays for BigQuery jobs (the dataset itself is public).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional: path to ADC credentials if not in the default gcloud location.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Models: primary and fallback.
RETAIL_MODEL=gemini-3.5-flash-lite
RETAIL_FALLBACK_MODEL=gemini-3.1-flash-lite

# Query limits.
RETAIL_MAX_BYTES_BILLED=1000000000
RETAIL_MAX_RESULT_ROWS=1000

# Salt for pseudonymous customer keys. Generate once: openssl rand -hex 16
RETAIL_PSEUDONYM_SALT=
